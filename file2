import boto3

def copy_specific_files(bucket_name, folder_prefix, match_string, new_prefix):
    s3 = boto3.resource('s3')
    bucket = s3.Bucket(bucket_name)
    
    # 1. 'Prefix' limits the search to a specific folder/directory
    for obj in bucket.objects.filter(Prefix=folder_prefix):
        
        # Get the filename (everything after the last slash)
        file_name = obj.key.split('/')[-1]
        
        # 2. Check if the filename starts with your specific string
        if file_name.startswith(match_string):
            new_key = f"{new_prefix}{file_name}"
            
            print(f"Found match! Copying {obj.key} to {new_key}")
            
            copy_source = {
                'Bucket': bucket_name,
                'Key': obj.key
            }
            
            # Perform the copy
            bucket.copy(copy_source, new_key)

# Example: Copy files in 'uploads/' that start with 'report_' to 'processed/'
copy_specific_files(
    bucket_name='my-bucket-name',
    folder_prefix='uploads/', 
    match_string='report_', 
    new_prefix='processed/'
)
